<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h1 class="fw-bold mb-1">Clientes</h1>
    <p class="text-muted mb-0">
      Gestiona los clientes registrados en el restaurante.
    </p>
  </div>

  <a href="/clients/new" class="btn btn-dark">
    <i class="bi bi-person-plus me-1"></i>
    Nuevo cliente
  </a>
</div>

<div class="card border-0 shadow-sm">
  <div class="card-body">
    <% if (clients.length === 0) { %>

      <div class="text-center py-5">
        <i class="bi bi-people display-4 text-muted"></i>

        <h2 class="h5 mt-3">
          No hay clientes registrados
        </h2>

        <p class="text-muted">
          Registra el primer cliente para comenzar.
        </p>

        <a href="/clients/new" class="btn btn-dark">
          Registrar cliente
        </a>
      </div>

    <% } else { %>

      <div class="table-responsive">
        <table class="table align-middle">
          <thead>
            <tr>
              <th>Cliente</th>
              <th>Teléfono</th>
              <th>Correo</th>
              <th class="text-end">Acciones</th>
            </tr>
          </thead>

          <tbody>
            <% clients.forEach(client => { %>
              <tr>
                <td>
                  <strong>
                    <%= client.first_name %>
                    <%= client.last_name %>
                  </strong>
                </td>

                <td>
                  <%= client.phone %>
                </td>

                <td>
                  <%= client.email || "No registrado" %>
                </td>

                <td class="text-end">
                  <a
                    href="/clients/<%= client.id %>/edit"
                    class="btn btn-sm btn-outline-dark"
                  >
                    <i class="bi bi-pencil"></i>
                  </a>

                  <form
                    action="/clients/<%= client.id %>?_method=DELETE"
                    method="POST"
                    class="d-inline"
                    onsubmit="return confirm('¿Deseas eliminar este cliente?')"
                  >
                    <button class="btn btn-sm btn-outline-danger">
                      <i class="bi bi-trash"></i>
                    </button>
                  </form>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>

    <% } %>
  </div>
</div>