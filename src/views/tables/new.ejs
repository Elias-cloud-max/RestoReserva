<div class="row justify-content-center">
  <div class="col-lg-8">

    <div class="mb-4">
      <a href="/tables" class="text-decoration-none text-muted">
        <i class="bi bi-arrow-left me-1"></i>
        Volver a mesas
      </a>
    </div>

    <div class="card border-0 shadow-sm">
      <div class="card-body p-4">

        <h1 class="h3 fw-bold mb-1">
          Nueva mesa
        </h1>

        <p class="text-muted mb-4">
          Registra una nueva mesa del restaurante.
        </p>

        <% if (error) { %>
          <div class="alert alert-danger">
            <%= error %>
          </div>
        <% } %>

        <form action="/tables" method="POST">

          <div class="row g-3">

            <div class="col-md-6">
              <label class="form-label">
                Número de mesa *
              </label>

              <input
                type="number"
                min="1"
                name="table_number"
                class="form-control"
                value="<%= table.table_number || '' %>"
                required
              >
            </div>

            <div class="col-md-6">
              <label class="form-label">
                Capacidad *
              </label>

              <input
                type="number"
                min="1"
                name="capacity"
                class="form-control"
                value="<%= table.capacity || '' %>"
                required
              >
            </div>

            <div class="col-md-6">
              <label class="form-label">
                Ubicación *
              </label>

              <select
                name="location"
                class="form-select"
                required
              >
                <option value="">Selecciona una ubicación</option>
                <option value="Interior">Interior</option>
                <option value="Terraza">Terraza</option>
                <option value="Exterior">Exterior</option>
                <option value="Área VIP">Área VIP</option>
              </select>
            </div>

            <div class="col-md-6">
              <label class="form-label">
                Estado *
              </label>

              <select
                name="status"
                class="form-select"
                required
              >
                <option value="Disponible">Disponible</option>
                <option value="Ocupada">Ocupada</option>
                <option value="Fuera de servicio">Fuera de servicio</option>
              </select>
            </div>

            <div class="col-12">
              <label class="form-label">
                Descripción
              </label>

              <textarea
                name="description"
                class="form-control"
                rows="4"
              ><%= table.description || '' %></textarea>
            </div>

          </div>

          <div class="d-flex justify-content-end gap-2 mt-4">

            <a href="/tables" class="btn btn-outline-secondary">
              Cancelar
            </a>

            <button type="submit" class="btn btn-dark">
              <i class="bi bi-check-lg me-1"></i>
              Guardar mesa
            </button>

          </div>

        </form>

      </div>
    </div>
  </div>
</div>