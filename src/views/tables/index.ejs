<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h1 class="fw-bold mb-1">Mesas</h1>
    <p class="text-muted mb-0">
      Gestiona las mesas disponibles en el restaurante.
    </p>
  </div>

  <a href="/tables/new" class="btn btn-dark">
    <i class="bi bi-plus-lg me-1"></i>
    Nueva mesa
  </a>
</div>

<div class="card border-0 shadow-sm">
  <div class="card-body">

    <% if (tables.length === 0) { %>

      <div class="text-center py-5">
        <i class="bi bi-grid display-4 text-muted"></i>

        <h2 class="h5 mt-3">
          No hay mesas registradas
        </h2>

        <p class="text-muted">
          Registra la primera mesa para comenzar.
        </p>

        <a href="/tables/new" class="btn btn-dark">
          Registrar mesa
        </a>
      </div>

    <% } else { %>

      <div class="table-responsive">
        <table class="table align-middle">

          <thead>
            <tr>
              <th>Mesa</th>
              <th>Capacidad</th>
              <th>Ubicación</th>
              <th>Estado</th>
              <th class="text-end">Acciones</th>
            </tr>
          </thead>

          <tbody>
            <% tables.forEach(table => { %>

              <tr>
                <td>
                  <strong>Mesa <%= table.table_number %></strong>
                </td>

                <td>
                  <%= table.capacity %> personas
                </td>

                <td>
                  <%= table.location %>
                </td>

                <td>
                  <% if (table.status === "Disponible") { %>
                    <span class="badge text-bg-success">
                      Disponible
                    </span>
                  <% } else if (table.status === "Ocupada") { %>
                    <span class="badge text-bg-danger">
                      Ocupada
                    </span>
                  <% } else { %>
                    <span class="badge text-bg-secondary">
                      <%= table.status %>
                    </span>
                  <% } %>
                </td>

                <td class="text-end">

                  <a
                    href="/tables/<%= table.id %>/edit"
                    class="btn btn-sm btn-outline-dark"
                  >
                    <i class="bi bi-pencil"></i>
                  </a>

                  <form
                    action="/tables/<%= table.id %>?_method=DELETE"
                    method="POST"
                    class="d-inline"
                    onsubmit="return confirm('¿Deseas eliminar esta mesa?')"
                  >
                    <button class="btn btn-sm btn-outline-danger">
                      <i class="bi bi-trash"></i>
                    </button>
                  </form>

                </td>
              </tr>

            <% }) %>
          </tbody>

        </table>
      </div>

    <% } %>

  </div>
</div>