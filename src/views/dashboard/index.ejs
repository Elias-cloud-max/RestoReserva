<div class="d-flex justify-content-between align-items-center mb-4">

  <div>
    <h1 class="fw-bold mb-1">
      Dashboard
    </h1>

    <p class="text-muted mb-0">
      Resumen general del sistema de reservas.
    </p>
  </div>

  <a href="/reservations/new" class="btn btn-dark">

    <i class="bi bi-plus-lg me-1"></i>

    Nueva reserva

  </a>

</div>


<div class="row g-4">


  <div class="col-md-6 col-xl-3">

    <div class="card dashboard-card border-0 shadow-sm h-100">

      <div class="card-body">

        <div class="d-flex justify-content-between align-items-center">

          <div>

            <span class="text-muted">
              Reservas de hoy
            </span>

            <h2 class="fw-bold mt-2 mb-0">
              <%= summary.today_reservations %>
            </h2>

          </div>

          <div class="dashboard-icon">

            <i class="bi bi-calendar-check"></i>

          </div>

        </div>

      </div>

    </div>

  </div>


  <div class="col-md-6 col-xl-3">

    <div class="card dashboard-card border-0 shadow-sm h-100">

      <div class="card-body">

        <div class="d-flex justify-content-between align-items-center">

          <div>

            <span class="text-muted">
              Clientes
            </span>

            <h2 class="fw-bold mt-2 mb-0">
              <%= summary.total_clients %>
            </h2>

          </div>

          <div class="dashboard-icon">

            <i class="bi bi-people"></i>

          </div>

        </div>

      </div>

    </div>

  </div>


  <div class="col-md-6 col-xl-3">

    <div class="card dashboard-card border-0 shadow-sm h-100">

      <div class="card-body">

        <div class="d-flex justify-content-between align-items-center">

          <div>

            <span class="text-muted">
              Mesas disponibles
            </span>

            <h2 class="fw-bold mt-2 mb-0">
              <%= summary.available_tables %>
            </h2>

            <small class="text-muted">
              de <%= summary.total_tables %> mesas
            </small>

          </div>

          <div class="dashboard-icon">

            <i class="bi bi-grid"></i>

          </div>

        </div>

      </div>

    </div>

  </div>


  <div class="col-md-6 col-xl-3">

    <div class="card dashboard-card border-0 shadow-sm h-100">

      <div class="card-body">

        <div class="d-flex justify-content-between align-items-center">

          <div>

            <span class="text-muted">
              Pendientes
            </span>

            <h2 class="fw-bold mt-2 mb-0">
              <%= summary.pending_reservations %>
            </h2>

          </div>

          <div class="dashboard-icon">

            <i class="bi bi-clock-history"></i>

          </div>

        </div>

      </div>

    </div>

  </div>


</div>


<div class="row g-4 mt-1">


  <div class="col-lg-8">

    <div class="card border-0 shadow-sm h-100">

      <div class="card-body">

        <div
          class="d-flex justify-content-between align-items-center mb-4"
        >

          <div>

            <h2 class="h5 fw-bold mb-1">
              Próximas reservas
            </h2>

            <span class="text-muted">
              Reservas programadas próximamente
            </span>

          </div>

          <a
            href="/reservations"
            class="btn btn-sm btn-outline-dark"
          >
            Ver todas
          </a>

        </div>


        <% if (upcomingReservations.length === 0) { %>

          <div class="text-center py-5 text-muted">

            <i class="bi bi-calendar-x display-5"></i>

            <p class="mt-3 mb-0">
              No hay próximas reservas.
            </p>

          </div>

        <% } else { %>

          <div class="table-responsive">

            <table class="table align-middle">

              <thead>

                <tr>
                  <th>Cliente</th>
                  <th>Mesa</th>
                  <th>Fecha</th>
                  <th>Hora</th>
                  <th>Personas</th>
                  <th>Estado</th>
                </tr>

              </thead>

              <tbody>

                <% upcomingReservations.forEach(reservation => { %>

                  <tr>

                    <td>

                      <strong>
                        <%= reservation.first_name %>
                        <%= reservation.last_name %>
                      </strong>

                    </td>

                    <td>
                      Mesa <%= reservation.table_number %>
                    </td>

                    <td>
                      <%= reservation.reservation_date %>
                    </td>

                    <td>
                      <%= reservation.reservation_time %>
                    </td>

                    <td>
                      <%= reservation.people %>
                    </td>

                    <td>

                      <% if (reservation.status === "Confirmada") { %>

                        <span class="badge text-bg-success">
                          Confirmada
                        </span>

                      <% } else if (reservation.status === "Pendiente") { %>

                        <span class="badge text-bg-warning">
                          Pendiente
                        </span>

                      <% } else { %>

                        <span class="badge text-bg-secondary">
                          <%= reservation.status %>
                        </span>

                      <% } %>

                    </td>

                  </tr>

                <% }) %>

              </tbody>

            </table>

          </div>

        <% } %>

      </div>

    </div>

  </div>


  <div class="col-lg-4">

    <div class="card border-0 shadow-sm mb-4">

      <div class="card-body">

        <h2 class="h5 fw-bold">
          Estado de reservas
        </h2>

        <p class="text-muted">
          Resumen actual de las reservas.
        </p>


        <div class="d-flex justify-content-between py-2 border-bottom">

          <span>
            Pendientes
          </span>

          <strong>
            <%= summary.pending_reservations %>
          </strong>

        </div>


        <div class="d-flex justify-content-between py-2">

          <span>
            Confirmadas
          </span>

          <strong>
            <%= summary.confirmed_reservations %>
          </strong>

        </div>

      </div>

    </div>


    <div class="card border-0 shadow-sm">

      <div class="card-body">

        <h2 class="h5 fw-bold">
          Acciones rápidas
        </h2>

        <p class="text-muted">
          Accede a las funciones principales.
        </p>


        <div class="d-grid gap-2">

          <a
            href="/reservations/new"
            class="btn btn-dark"
          >

            <i class="bi bi-calendar-plus me-2"></i>

            Crear reserva

          </a>


          <a
            href="/clients/new"
            class="btn btn-outline-dark"
          >

            <i class="bi bi-person-plus me-2"></i>

            Nuevo cliente

          </a>


          <a
            href="/tables/new"
            class="btn btn-outline-dark"
          >

            <i class="bi bi-plus-square me-2"></i>

            Nueva mesa

          </a>

        </div>

      </div>

    </div>

  </div>


</div>