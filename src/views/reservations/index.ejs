<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h1 class="fw-bold mb-1">Reservas</h1>

    <p class="text-muted mb-0">
      Gestiona las reservas registradas en el restaurante.
    </p>
  </div>

  <a href="/reservations/new" class="btn btn-dark">
    <i class="bi bi-calendar-plus me-1"></i>
    Nueva reserva
  </a>
</div>


<!-- Filtros de reservas -->
<form method="GET" action="/reservations" class="mb-4">

  <div class="row g-2">

    <div class="col-lg-4">

      <div class="input-group">

        <span class="input-group-text">
          <i class="bi bi-search"></i>
        </span>

        <input
          type="text"
          name="search"
          class="form-control"
          placeholder="Buscar por nombre del cliente..."
          value="<%= typeof filters !== 'undefined' ? filters.search || '' : '' %>"
        >

      </div>

    </div>


    <div class="col-lg-3">

      <select
        name="status"
        class="form-select"
      >

        <option value="">
          Todos los estados
        </option>

        <% [
          "Pendiente",
          "Confirmada",
          "En curso",
          "Completada",
          "Cancelada",
          "No asistió"
        ].forEach(status => { %>

          <option
            value="<%= status %>"
            <%= typeof filters !== "undefined" && filters.status === status ? "selected" : "" %>
          >
            <%= status %>
          </option>

        <% }) %>

      </select>

    </div>


    <div class="col-lg-3">

      <input
        type="date"
        name="date"
        class="form-control"
        value="<%= typeof filters !== 'undefined' ? filters.date || '' : '' %>"
      >

    </div>


    <div class="col-lg-2 d-flex gap-2">

      <button
        type="submit"
        class="btn btn-dark flex-grow-1"
      >
        <i class="bi bi-funnel me-1"></i>
        Filtrar
      </button>

      <% if (
        typeof filters !== "undefined" &&
        (filters.search || filters.status || filters.date)
      ) { %>

        <a
          href="/reservations"
          class="btn btn-outline-secondary"
          title="Limpiar filtros"
        >
          <i class="bi bi-x-lg"></i>
        </a>

      <% } %>

    </div>

  </div>

</form>


<!-- Listado de reservas -->
<div class="card border-0 shadow-sm">
  <div class="card-body">

    <% if (reservations.length === 0) { %>

      <div class="text-center py-5">

        <i class="bi bi-calendar-x display-4 text-muted"></i>

        <% if (
          typeof filters !== "undefined" &&
          (filters.search || filters.status || filters.date)
        ) { %>

          <h2 class="h5 mt-3">
            No se encontraron reservas
          </h2>

          <p class="text-muted">
            No hay reservas que coincidan con los filtros seleccionados.
          </p>

          <a
            href="/reservations"
            class="btn btn-outline-dark"
          >
            Ver todas las reservas
          </a>

        <% } else { %>

          <h2 class="h5 mt-3">
            No hay reservas registradas
          </h2>

          <p class="text-muted">
            Registra la primera reserva para comenzar.
          </p>

          <a href="/reservations/new" class="btn btn-dark">
            Crear reserva
          </a>

        <% } %>

      </div>

    <% } else { %>

      <div class="table-responsive">

        <table class="table align-middle">

          <thead>
            <tr>
              <th>Cliente</th>
              <th>Mesa</th>
              <th>Fecha</th>
              <th>Hora</th>
              <th>Personas</th>
              <th>Estado</th>
              <th class="text-end">Acciones</th>
            </tr>
          </thead>

          <tbody>

            <% reservations.forEach(reservation => { %>

              <tr>

                <td>
                  <strong>
                    <%= reservation.first_name %>
                    <%= reservation.last_name %>
                  </strong>
                </td>

                <td>
                  Mesa <%= reservation.table_number %>
                </td>

                <td>
                  <%= reservation.reservation_date %>
                </td>

                <td>
                  <%= reservation.reservation_time %>
                </td>

                <td>
                  <%= reservation.people %>
                </td>

                <td>

                  <% if (reservation.status === "Confirmada") { %>

                    <span class="badge text-bg-success">
                      Confirmada
                    </span>

                  <% } else if (reservation.status === "Pendiente") { %>

                    <span class="badge text-bg-warning">
                      Pendiente
                    </span>

                  <% } else if (reservation.status === "En curso") { %>

                    <span class="badge text-bg-info">
                      En curso
                    </span>

                  <% } else if (reservation.status === "Cancelada") { %>

                    <span class="badge text-bg-danger">
                      Cancelada
                    </span>

                  <% } else if (reservation.status === "Completada") { %>

                    <span class="badge text-bg-primary">
                      Completada
                    </span>

                  <% } else if (reservation.status === "No asistió") { %>

                    <span class="badge text-bg-secondary">
                      No asistió
                    </span>

                  <% } else { %>

                    <span class="badge text-bg-secondary">
                      <%= reservation.status %>
                    </span>

                  <% } %>

                </td>

                <td class="text-end">

                  <a
                    href="/reservations/<%= reservation.id %>/edit"
                    class="btn btn-sm btn-outline-dark"
                    title="Editar reserva"
                  >
                    <i class="bi bi-pencil"></i>
                  </a>

                  <form
                    action="/reservations/<%= reservation.id %>?_method=DELETE"
                    method="POST"
                    class="d-inline"
                    onsubmit="return confirm('¿Deseas eliminar esta reserva?')"
                  >

                    <button
                      type="submit"
                      class="btn btn-sm btn-outline-danger"
                      title="Eliminar reserva"
                    >
                      <i class="bi bi-trash"></i>
                    </button>

                  </form>

                </td>

              </tr>

            <% }) %>

          </tbody>

        </table>

      </div>

    <% } %>

  </div>
</div>