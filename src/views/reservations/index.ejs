<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h1 class="fw-bold mb-1">Reservas</h1>

    <p class="text-muted mb-0">
      Gestiona las reservas registradas en el restaurante.
    </p>
  </div>

  <a href="/reservations/new" class="btn btn-dark">
    <i class="bi bi-calendar-plus me-1"></i>
    Nueva reserva
  </a>
</div>

<div class="card border-0 shadow-sm">
  <div class="card-body">

    <% if (reservations.length === 0) { %>

      <div class="text-center py-5">

        <i class="bi bi-calendar-x display-4 text-muted"></i>

        <h2 class="h5 mt-3">
          No hay reservas registradas
        </h2>

        <p class="text-muted">
          Registra la primera reserva para comenzar.
        </p>

        <a href="/reservations/new" class="btn btn-dark">
          Crear reserva
        </a>

      </div>

    <% } else { %>

      <div class="table-responsive">

        <table class="table align-middle">

          <thead>
            <tr>
              <th>Cliente</th>
              <th>Mesa</th>
              <th>Fecha</th>
              <th>Hora</th>
              <th>Personas</th>
              <th>Estado</th>
              <th class="text-end">Acciones</th>
            </tr>
          </thead>

          <tbody>

            <% reservations.forEach(reservation => { %>

              <tr>

                <td>
                  <strong>
                    <%= reservation.first_name %>
                    <%= reservation.last_name %>
                  </strong>
                </td>

                <td>
                  Mesa <%= reservation.table_number %>
                </td>

                <td>
                  <%= reservation.reservation_date %>
                </td>

                <td>
                  <%= reservation.reservation_time %>
                </td>

                <td>
                  <%= reservation.people %>
                </td>

                <td>

                  <% if (reservation.status === "Confirmada") { %>

                    <span class="badge text-bg-success">
                      Confirmada
                    </span>

                  <% } else if (reservation.status === "Pendiente") { %>

                    <span class="badge text-bg-warning">
                      Pendiente
                    </span>

                  <% } else if (reservation.status === "Cancelada") { %>

                    <span class="badge text-bg-danger">
                      Cancelada
                    </span>

                  <% } else if (reservation.status === "Completada") { %>

                    <span class="badge text-bg-primary">
                      Completada
                    </span>

                  <% } else { %>

                    <span class="badge text-bg-secondary">
                      <%= reservation.status %>
                    </span>

                  <% } %>

                </td>

                <td class="text-end">

                  <a
                    href="/reservations/<%= reservation.id %>/edit"
                    class="btn btn-sm btn-outline-dark"
                  >
                    <i class="bi bi-pencil"></i>
                  </a>

                  <form
                    action="/reservations/<%= reservation.id %>?_method=DELETE"
                    method="POST"
                    class="d-inline"
                    onsubmit="return confirm('¿Deseas eliminar esta reserva?')"
                  >

                    <button class="btn btn-sm btn-outline-danger">
                      <i class="bi bi-trash"></i>
                    </button>

                  </form>

                </td>

              </tr>

            <% }) %>

          </tbody>

        </table>

      </div>

    <% } %>

  </div>
</div>